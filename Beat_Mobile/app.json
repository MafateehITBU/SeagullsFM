{
  "expo": {
    "name": "Beat FM",
    "slug": "beatfm-mobile",
    "version": "7.8",
    "orientation": "portrait",
    "icon": "./assets/img/appIcon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/img/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0c0c"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "assetBundlePatterns": [
      "**/*",
      "assets/fonts/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beatfm.102.5beatfm",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Beat FM uses your photo library so you can choose a profile picture for your account.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/appIcon.png",
        "backgroundColor": "#0c0c0c"
      },
      "package": "ac.radio.Beatfm",
      "versionCode": 11
    },
    "scheme": "beatfm",
    "extra": {
      "eas": {
        "projectId": "f1839115-4e0c-4696-81cf-afaf36df3c33"
      }
    }
  }
}
